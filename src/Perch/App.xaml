<Application x:Class="Perch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Perch.Views.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Perch and Brisk are the same person's tools, so they share a look:
                flat, square-edged, dense, one blue accent. Everything below overrides
                the WinUI defaults that WPF-UI ships with — the controls stay native,
                the surface does not.
            -->

            <Color x:Key="ShellBackground">#FF14161A</Color>
            <Color x:Key="ShellSide">#FF101216</Color>
            <Color x:Key="ShellCard">#FF1C1F26</Color>
            <Color x:Key="ShellCardHover">#FF23272F</Color>
            <Color x:Key="ShellLine">#FF2A2F3A</Color>
            <Color x:Key="ShellText">#FFE6E9EF</Color>
            <Color x:Key="ShellMuted">#FF8B93A3</Color>
            <Color x:Key="ShellAccent">#FF4C8DFF</Color>
            <Color x:Key="ShellGood">#FF3FBF7F</Color>
            <Color x:Key="ShellWarn">#FFE0A33E</Color>
            <Color x:Key="ShellBad">#FFE5544B</Color>

            <SolidColorBrush x:Key="Shell.Background" Color="{StaticResource ShellBackground}" />
            <SolidColorBrush x:Key="Shell.Side" Color="{StaticResource ShellSide}" />
            <SolidColorBrush x:Key="Shell.Card" Color="{StaticResource ShellCard}" />
            <SolidColorBrush x:Key="Shell.CardHover" Color="{StaticResource ShellCardHover}" />
            <SolidColorBrush x:Key="Shell.Line" Color="{StaticResource ShellLine}" />
            <SolidColorBrush x:Key="Shell.Text" Color="{StaticResource ShellText}" />
            <SolidColorBrush x:Key="Shell.Muted" Color="{StaticResource ShellMuted}" />
            <SolidColorBrush x:Key="Shell.Accent" Color="{StaticResource ShellAccent}" />
            <SolidColorBrush x:Key="Shell.Good" Color="{StaticResource ShellGood}" />
            <SolidColorBrush x:Key="Shell.Warn" Color="{StaticResource ShellWarn}" />
            <SolidColorBrush x:Key="Shell.Bad" Color="{StaticResource ShellBad}" />

            <!-- Square corners throughout: the single biggest difference from stock WinUI. -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

            <!-- WinUI palette, repainted. -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ShellBackground}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ShellBackground}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource ShellSide}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource ShellCard}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource ShellCard}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource ShellCard}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ShellSide}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource ShellLine}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ShellCard}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ShellCardHover}" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF191C22" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ShellLine}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource ShellLine}" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource ShellLine}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource ShellText}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource ShellMuted}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6C7484" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF565D6B" />

            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

            <!-- ==================== Type ==================== -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
            </Style>

            <Style x:Key="Lede" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Muted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,20" />
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RowCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Muted}" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Brisk's sidebar section labels: small, spaced, muted. -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Muted}" />
                <Setter Property="Margin" Value="2,22,0,10" />
            </Style>

            <Style x:Key="BigNumber" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
            </Style>

            <!-- ==================== Surfaces ==================== -->
            <!--
                The row: flat card, hairline border, and a coloured stripe down the left
                edge that turns solid accent when the row is live. Hovering lifts the
                border to the accent rather than moving anything.
            -->
            <Style x:Key="Row" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Shell.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shell.Line}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Shell.CardHover}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Sidebar entry, 44 px like Brisk's: a 3 px accent bar marks the active
                page, the icon goes accent while the label goes full white, and
                everything else stays muted.
            -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Muted}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Background="Transparent">
                                <Rectangle x:Name="Stripe" Width="3" HorizontalAlignment="Left"
                                           Margin="0,8" Fill="{DynamicResource Shell.Accent}"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="20,0,12,0"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="Glyph" FontSize="17"
                                                   Symbol="{Binding Path=(controls:Nav.Icon),
                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource Shell.Muted}" />
                                    <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FF16191F" />
                                    <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FF1B1F28" />
                                    <Setter TargetName="Stripe" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Foreground"
                                            Value="{DynamicResource Shell.Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Shell.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shell.Line}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
