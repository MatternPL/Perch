<Window x:Class="Perch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Perch"
        Width="960" Height="660"
        MinWidth="820" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== Title bar ==================== -->
            <Border x:Name="TitleBar" Grid.Row="0" Height="44" Background="#FF0D0F15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- The mark: a window, and a smaller one perched on top of it. -->
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Rectangle Width="11" Height="10" RadiusX="2.5" RadiusY="2.5"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Fill="#FF212632" Stroke="#FF5C667C" StrokeThickness="1.4" />
                            <Rectangle Width="9" Height="8" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Fill="{StaticResource Accent}" Stroke="#FF0D0F15" StrokeThickness="1.4" />
                        </Grid>
                        <TextBlock Text="Perch" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock x:Name="VersionLabel" Text="1.0.0" Margin="8,1,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource TextMuted}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimise"
                                Click="Minimise_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close to tray"
                                Click="CloseToTray_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== Body ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#FF0D0F15" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0">
                    <DockPanel Margin="16,18,16,16">
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton x:Name="TabPinned" Style="{StaticResource SideTab}" GroupName="Nav"
                                         IsChecked="True" Checked="Tab_Checked" Tag="Pinned"
                                         Content="Pin a window" />
                            <RadioButton x:Name="TabOverlay" Style="{StaticResource SideTab}" GroupName="Nav"
                                         Checked="Tab_Checked" Tag="Overlay" Content="Floating overlay" />
                            <RadioButton x:Name="TabRules" Style="{StaticResource SideTab}" GroupName="Nav"
                                         Checked="Tab_Checked" Tag="Rules" Content="Placement rules" />
                            <RadioButton x:Name="TabSettings" Style="{StaticResource SideTab}" GroupName="Nav"
                                         Checked="Tab_Checked" Tag="Settings" Content="Settings" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="{StaticResource CornerSmall}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="QUICK" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="PinHint" Style="{StaticResource Caption}" FontSize="11"
                                               Text="Ctrl+Alt+P pins the focused window" />
                                    <TextBlock x:Name="OverlayHint" Style="{StaticResource Caption}" FontSize="11"
                                               Margin="0,4,0,0" Text="Ctrl+Alt+O toggles the overlay" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid />
                    </DockPanel>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,22">
                    <Grid>

                        <!-- ==================== Overlay page ==================== -->
                        <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                            <TextBlock Text="Floating overlay" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,18"
                                       Text="A small always-on-top viewer for video while you play. Drag it anywhere on your screen." />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OPEN" Style="{StaticResource SectionHeading}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OverlayUrl" Grid.Column="0" Style="{StaticResource Field}"
                                                 KeyDown="OverlayUrl_KeyDown" />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                                Content="Open overlay" Click="OpenOverlay_Click" />
                                    </Grid>

                                    <ItemsControl x:Name="BookmarkList" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Content="{Binding}"
                                                        Tag="{Binding}" Margin="0,0,8,8" Padding="10,5" FontSize="12"
                                                        Click="Bookmark_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeading}" />

                                    <CheckBox x:Name="ChkAggressive" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Fight for the top of the stack"
                                              Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="46,-10,0,14" FontSize="11"
                                               Text="Re-asserts always-on-top every 1.5 s. Leave this on for games." />

                                    <CheckBox x:Name="ChkNoActivate" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Never steal keyboard focus"
                                              Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="46,-10,0,14" FontSize="11"
                                               Text="Clicking the overlay will not pull focus out of a borderless game — but you also cannot type into the page." />

                                    <CheckBox x:Name="ChkClickThrough" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Click-through"
                                              Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="46,-10,0,14" FontSize="11"
                                               Text="The mouse passes straight through to whatever is underneath." />

                                    <CheckBox x:Name="ChkAutoHide" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Hide the toolbar until I hover"
                                              Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed" />

                                    <TextBlock Text="OPACITY" Style="{StaticResource SectionHeading}" Margin="0,10,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="OpacityControl" Grid.Column="0" Style="{StaticResource ThinSlider}"
                                                Minimum="0.2" Maximum="1.0" SmallChange="0.05"
                                                ValueChanged="OpacityControl_ValueChanged" />
                                        <TextBlock x:Name="OpacityLabel" Grid.Column="1" Style="{StaticResource Caption}"
                                                   Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="#FF1A1710" BorderBrush="#FF3A3020">
                                <StackPanel>
                                    <TextBlock Text="ABOUT FULL-SCREEN GAMES" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Style="{StaticResource Body}" FontSize="12"
                                               Text="An overlay can only sit above a game running in windowed or borderless mode. In exclusive full-screen, Windows hands the display straight to the game and hides every other window — no application can draw over that without hooking the game's renderer, which anti-cheat treats as tampering. Set your game to Borderless and the overlay works." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== Pinned page ==================== -->
                        <StackPanel x:Name="PagePinned">
                            <TextBlock Text="Pin a window" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,18"
                                       Text="Keep a window you already have open above everything else — your own browser, a video player, a chat window. It stays your window; Perch only holds it on top." />

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PinnedCount" Style="{StaticResource Body}" Text="0 windows pinned" />
                                        <TextBlock x:Name="PinHotkeyLabel" Style="{StaticResource Caption}" FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Refresh"
                                            Click="RefreshWindows_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Unpin all"
                                            Click="UnpinAll_Click" />
                                </Grid>
                            </Border>

                            <ListBox x:Name="WindowList" Style="{StaticResource PlainList}"
                                     ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                           FontSize="11" Margin="0,2,0,0" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="{Binding ActionLabel}" Tag="{Binding}"
                                                    Padding="12,5" FontSize="12" Click="TogglePin_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- ==================== Rules page ==================== -->
                        <StackPanel x:Name="PageRules" Visibility="Collapsed">
                            <TextBlock Text="Placement rules" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,18"
                                       Text="Send an app to the monitor it belongs on, every time it opens. Discord maximised on monitor 2, for example." />

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkRulesEnabled" Grid.Column="0" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Content="Rules are running"
                                              Checked="RulesEnabled_Changed" Unchecked="RulesEnabled_Changed" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Content="Apply to open windows" Click="ApplyAll_Click" />
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                            Content="New rule" Click="NewRule_Click" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="NoRulesHint" Style="{StaticResource Caption}" Margin="2,4,0,0"
                                       Text="No rules yet. Create one and pick the app from the list of what is running." />

                            <ListBox x:Name="RuleList" Style="{StaticResource PlainList}"
                                     ItemContainerStyle="{StaticResource RowItem}"
                                     MouseDoubleClick="RuleList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0"
                                                      IsChecked="{Binding Rule.Enabled, Mode=TwoWay}"
                                                      Tag="{Binding}" Checked="RuleEnabled_Changed"
                                                      Unchecked="RuleEnabled_Changed" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Body}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                           FontSize="11" Margin="0,2,0,0" TextWrapping="NoWrap" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Apply now"
                                                    Tag="{Binding}" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                                    Click="ApplyRule_Click" />
                                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Edit"
                                                    Tag="{Binding}" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                                    Click="EditRule_Click" />
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    Tag="{Binding}" ToolTip="Delete rule" Click="DeleteRule_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- ==================== Settings page ==================== -->
                        <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                            <TextBlock Text="Settings" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,18"
                                       Text="Shortcuts work everywhere, including while a game has focus." />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,-4,0,12"
                                               Text="Click a field and press the combination you want. It must include Ctrl, Alt, Shift or Win." />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Pin the focused window" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="HkPin" Grid.Column="1" Style="{StaticResource Field}"
                                                 IsReadOnly="True" Tag="pin" PreviewKeyDown="Hotkey_PreviewKeyDown" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Show / hide the overlay" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="HkOverlay" Grid.Column="1" Style="{StaticResource Field}"
                                                 IsReadOnly="True" Tag="overlay" PreviewKeyDown="Hotkey_PreviewKeyDown" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Toggle click-through" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="HkClickThrough" Grid.Column="1" Style="{StaticResource Field}"
                                                 IsReadOnly="True" Tag="clickthrough" PreviewKeyDown="Hotkey_PreviewKeyDown" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="More opaque" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="HkOpacityUp" Grid.Column="1" Style="{StaticResource Field}"
                                                 IsReadOnly="True" Tag="opacityup" PreviewKeyDown="Hotkey_PreviewKeyDown" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="More transparent" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="HkOpacityDown" Grid.Column="1" Style="{StaticResource Field}"
                                                 IsReadOnly="True" Tag="opacitydown" PreviewKeyDown="Hotkey_PreviewKeyDown" />
                                    </Grid>

                                    <TextBlock x:Name="HotkeyWarning" Style="{StaticResource Caption}" Margin="0,12,0,0"
                                               FontSize="11" Foreground="{StaticResource Danger}"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="STARTUP" Style="{StaticResource SectionHeading}" />
                                    <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Start Perch when I sign in"
                                              Checked="General_Changed" Unchecked="General_Changed" />
                                    <CheckBox x:Name="ChkStartMinimized" Style="{StaticResource Switch}" Margin="0,0,0,12"
                                              Content="Start in the tray, no window"
                                              Checked="General_Changed" Unchecked="General_Changed" />
                                    <CheckBox x:Name="ChkNotifications" Style="{StaticResource Switch}"
                                              Content="Show tray notifications"
                                              Checked="General_Changed" Unchecked="General_Changed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FILES" Style="{StaticResource SectionHeading}" />
                                    <TextBlock x:Name="ConfigPathLabel" Style="{StaticResource Caption}" FontSize="11"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="Open config folder"
                                                Click="OpenConfigFolder_Click" Margin="0,0,8,0" FontSize="12" Padding="10,5" />
                                        <Button Style="{StaticResource GhostButton}" Content="Open log"
                                                Click="OpenLog_Click" FontSize="12" Padding="10,5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== Status bar ==================== -->
            <Border Grid.Row="2" Height="30" Background="#FF0D0F15" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="11"
                               VerticalAlignment="Center" Text="Ready" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="Closing this window keeps Perch running in the tray" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
