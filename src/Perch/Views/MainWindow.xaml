<ui:FluentWindow x:Class="Perch.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Perch.Views.Controls"
                 Title="Perch"
                 Width="1020" Height="680"
                 MinWidth="840" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource Shell.Background}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sidebar runs the full height, the way Brisk's does. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{DynamicResource Shell.Side}"
                BorderBrush="{DynamicResource Shell.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="48" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/perch.ico" Width="18" Height="18" />
                        <TextBlock Text="Perch" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Shell.Text}" />
                        <TextBlock x:Name="VersionChip" Margin="8,2,0,0" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="{DynamicResource Shell.Muted}" />
                    </StackPanel>
                </Border>

                <!-- What Perch is doing right now, always in view. -->
                <Border DockPanel.Dock="Bottom" Padding="20,14"
                        BorderBrush="{DynamicResource Shell.Line}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{DynamicResource Shell.Good}" />
                            <TextBlock x:Name="StatusText" Margin="9,0,0,0" FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Shell.Text}" Text="Watching" />
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" FontSize="11" Margin="16,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Shell.Muted}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="WINDOWS" Style="{StaticResource GroupLabel}" Margin="20,4,0,4" />

                    <RadioButton x:Name="TabPin" Style="{StaticResource NavItem}" GroupName="Nav"
                                 controls:Nav.Icon="Pin24" IsChecked="True"
                                 Checked="Nav_Checked" Tag="Pin" Content="Pin a window" />

                    <RadioButton x:Name="TabRules" Style="{StaticResource NavItem}" GroupName="Nav"
                                 controls:Nav.Icon="DualScreen24"
                                 Checked="Nav_Checked" Tag="Rules" Content="Placement rules" />

                    <TextBlock Text="PERCH" Style="{StaticResource GroupLabel}" Margin="20,16,0,4" />

                    <RadioButton x:Name="TabSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 controls:Nav.Icon="Settings24"
                                 Checked="Nav_Checked" Tag="Settings" Content="Settings" />

                    <RadioButton x:Name="TabAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 controls:Nav.Icon="Info24"
                                 Checked="Nav_Checked" Tag="About" Content="About" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ui:TitleBar Grid.Row="0" Grid.Column="1" Title="" ShowMaximize="True" ShowMinimize="True"
                     Height="48" />

        <Border Grid.Row="1" Grid.Column="1" Padding="28,0,0,0">
            <Frame x:Name="Host" NavigationUIVisibility="Hidden" Background="Transparent" />
        </Border>

        <ui:SnackbarPresenter x:Name="Snackbar" Grid.Row="1" Grid.Column="1"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              Margin="0,0,0,20" />
    </Grid>
</ui:FluentWindow>
