<Window x:Class="Perch.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pick an app"
        Width="520" Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Background}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Height="44" Background="#FF0D0F15">
                <Grid Margin="16,0">
                    <TextBlock Text="Running applications" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Field}" Margin="16,14,16,10"
                     TextChanged="SearchBox_TextChanged" ToolTip="Filter" />

            <ListBox x:Name="AppList" Grid.Row="2" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource RowItem}" Margin="16,0"
                     MouseDoubleClick="AppList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Display}" Style="{StaticResource Body}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Caption}"
                                       FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Background="#FF0D0F15" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Use this app" Click="Choose_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
