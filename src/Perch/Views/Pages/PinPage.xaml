<Page x:Class="Perch.Views.Pages.PinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Pin a window">

    <Page.Resources>
        <!-- One row per window: stripe, icon, two lines of text, one action. -->
        <DataTemplate x:Key="WindowRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="3" Fill="{Binding StripeBrush}" />

                    <Grid Grid.Column="1" Width="22" Height="22" Margin="15,12,0,12"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Stretch="Uniform" />
                        <ui:SymbolIcon Symbol="Window24" FontSize="17"
                                       Foreground="{DynamicResource Shell.Muted}"
                                       Visibility="{Binding FallbackGlyphVisibility}" />
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,14,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowCaption}" />
                    </StackPanel>

                    <ui:Button Grid.Column="3" Content="{Binding ActionLabel}" Tag="{Binding}"
                               Click="TogglePin_Click" MinWidth="92" Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="0,0,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pin a window" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Lede}"
                       Text="Keep a window you already have open above everything else — your own browser, a video player, a chat window. It stays your window; Perch only holds it on top." />
        </StackPanel>

        <!-- Count on the left, controls on the right, accent bar down the edge. -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Width="4" Fill="{DynamicResource Shell.Accent}" />

                <StackPanel Grid.Column="1" Margin="20,14,0,14" VerticalAlignment="Center">
                    <TextBlock x:Name="PinnedNumber" Text="0" Style="{StaticResource BigNumber}"
                               LineHeight="38" />
                    <TextBlock x:Name="PinnedCaption" Text="windows on top"
                               Style="{StaticResource RowCaption}" Margin="0,0,0,0" />
                </StackPanel>

                <!-- One gesture per line: wrapping mid-shortcut reads as gibberish. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="26,0,20,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Background="{DynamicResource Shell.Background}"
                                BorderBrush="{DynamicResource Shell.Line}" BorderThickness="1"
                                Padding="7,2" MinWidth="86">
                            <TextBlock x:Name="PinKeyLabel" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Shell.Text}" />
                        </Border>
                        <TextBlock Text="pins the window in front" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Shell.Muted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource Shell.Background}"
                                BorderBrush="{DynamicResource Shell.Line}" BorderThickness="1"
                                Padding="7,2" MinWidth="86">
                            <TextBlock x:Name="UnpinKeyLabel" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Shell.Text}" />
                        </Border>
                        <TextBlock Text="releases everything" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Shell.Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <ui:TextBox x:Name="Filter" Width="180" Margin="0,0,8,0"
                                PlaceholderText="Filter" TextChanged="Filter_TextChanged">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <ui:Button ToolTip="Refresh the list" Click="Refresh_Click" Margin="0,0,6,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="UnpinAllButton" Content="Unpin all" Click="UnpinAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="PinnedSection">
                    <TextBlock Text="HELD ON TOP" Style="{StaticResource GroupLabel}" Margin="2,0,0,8" />
                    <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource WindowRow}" />
                </StackPanel>

                <TextBlock x:Name="OtherLabel" Text="OPEN WINDOWS" Style="{StaticResource GroupLabel}" />
                <ItemsControl x:Name="OtherList" ItemTemplate="{StaticResource WindowRow}" />

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,50,0,0">
                    <ui:SymbolIcon Symbol="Search24" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Shell.Muted}" />
                    <TextBlock Text="Nothing matches that filter" FontSize="14" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Shell.Muted}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
