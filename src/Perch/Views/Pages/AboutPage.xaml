<Page x:Class="Perch.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,28,20">

            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Lede}"
                       Text="A small tool for wide and multi-monitor desks: hold a window above the rest, and send apps to the screen they belong on." />

            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="4" Fill="{DynamicResource Shell.Accent}" />

                    <Grid Grid.Column="1" Margin="22,20,22,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="pack://application:,,,/Assets/perch.ico"
                               Width="44" Height="44" Margin="0,0,18,0" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock x:Name="VersionLabel" Text="Perch" FontSize="18"
                                       FontWeight="Light" Foreground="{DynamicResource Shell.Text}" />
                            <TextBlock Text="MIT licence · by Mathias Andresen"
                                       Style="{StaticResource RowCaption}" />
                            <TextBlock x:Name="ConfigPathLabel" Style="{StaticResource RowCaption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <ui:Button Content="Project page" Click="OpenRepo_Click"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Open24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Settings folder" Click="OpenConfigFolder_Click"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <ui:Button Content="Log file" Click="OpenLog_Click"
                                       HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Text="WHAT IT CANNOT DO" Style="{StaticResource GroupLabel}" />

            <Border Style="{StaticResource Row}" IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="3" Fill="{DynamicResource Shell.Warn}" />
                    <StackPanel Grid.Column="1" Margin="18,14,18,14">
                        <TextBlock Text="Exclusive full-screen games"
                                   Style="{StaticResource RowTitle}" TextTrimming="None" />
                        <TextBlock Style="{StaticResource RowCaption}" TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="When a game takes the display in exclusive full-screen, Windows hands the whole output to it and hides every other window. Nothing can draw over that without hooking the game's renderer, which anti-cheat treats as tampering. Set the game to Borderless and pinning works." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Row}" IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="3" Fill="{DynamicResource Shell.Warn}" />
                    <StackPanel Grid.Column="1" Margin="18,14,18,14">
                        <TextBlock Text="Windows that refuse to be moved"
                                   Style="{StaticResource RowTitle}" TextTrimming="None" />
                        <TextBlock Style="{StaticResource RowCaption}" TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="A few apps run elevated. Perch runs as you, and Windows does not let an ordinary program reach into a window owned by an administrator process — those rows simply will not respond." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
