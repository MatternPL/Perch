<Page x:Class="Perch.Views.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Perch.Views.Controls"
      Title="Placement rules">

    <Grid Margin="0,0,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Placement rules" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Lede}"
                       Text="Send an app to the monitor it belongs on, every time it opens. Discord maximised on monitor 2, for example." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Your actual desk, to scale, so "monitor 2" means something. -->
            <controls:MonitorMap x:Name="Map" Grid.Column="0" Height="164" Margin="0,0,10,0" />

            <Border Grid.Column="1" Style="{StaticResource Panel}" Width="264">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="StateStripe" Grid.Column="0" Width="4"
                               Fill="{DynamicResource Shell.Good}" />

                    <StackPanel Grid.Column="1" Margin="18,16,18,16">
                        <TextBlock x:Name="RulesHeadline" Text="Watching" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Shell.Text}" />
                        <TextBlock x:Name="RulesState" Style="{StaticResource RowCaption}"
                                   TextWrapping="Wrap" Margin="0,4,0,14" />

                        <ui:ToggleSwitch x:Name="ChkRulesEnabled" Content="Rules are running"
                                         Checked="RulesEnabled_Changed" Unchecked="RulesEnabled_Changed"
                                         Margin="0,0,0,16" />

                        <ui:Button Content="New rule" Appearance="Primary" Click="NewRule_Click"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Apply to open windows" Click="ApplyAll_Click"
                                   HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,40,0,0">
                <ui:SymbolIcon Symbol="DualScreen24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Shell.Muted}" />
                <TextBlock Text="No rules yet" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Shell.Text}" />
                <TextBlock Text="Create one and pick the app from the list of what is running."
                           Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="RulesLabel" Text="RULES" Style="{StaticResource GroupLabel}"
                               Margin="2,0,0,8" />
                    <ItemsControl x:Name="RuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0" Width="3" Fill="{Binding StripeBrush}" />

                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                         Margin="15,10,0,10"
                                                         IsChecked="{Binding Rule.Enabled, Mode=TwoWay}"
                                                         Checked="RuleEnabled_Changed"
                                                         Unchecked="RuleEnabled_Changed" />

                                        <Grid Grid.Column="2" Width="22" Height="22" Margin="12,0,0,0"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                            <ui:SymbolIcon Symbol="Window24" FontSize="17"
                                                           Foreground="{DynamicResource Shell.Muted}"
                                                           Visibility="{Binding FallbackGlyphVisibility}" />
                                        </Grid>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    Margin="14,0,14,0">
                                            <TextBlock Text="{Binding Headline}"
                                                       Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource RowCaption}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="4" Content="Apply now" Tag="{Binding}"
                                                   Click="ApplyRule_Click" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="5" Content="Edit" Tag="{Binding}"
                                                   Click="EditRule_Click" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="6" Tag="{Binding}" Click="DeleteRule_Click"
                                                   ToolTip="Delete rule" Margin="0,0,12,0"
                                                   VerticalAlignment="Center">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
