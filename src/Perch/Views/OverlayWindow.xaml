<Window x:Class="Perch.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Perch Overlay"
        Width="640" Height="380"
        MinWidth="320" MinHeight="200"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Background}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border x:Name="Toolbar" Grid.Row="0" Background="#FF12151D" Height="34"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Drag handle -->
                    <Border x:Name="DragHandle" Grid.Column="0" Background="Transparent"
                            Width="26" Cursor="SizeAll" ToolTip="Drag to move">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE72B;" ToolTip="Back" Click="Back_Click" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" />

                    <TextBox x:Name="AddressBox" Grid.Column="3" Style="{StaticResource Field}"
                             Margin="6,4" Padding="8,2" FontSize="12" VerticalContentAlignment="Center"
                             KeyDown="AddressBox_KeyDown" ToolTip="Address — press Enter to go" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,8,0" ToolTip="Opacity">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="OpacitySlider" Style="{StaticResource ThinSlider}" Width="72"
                                Minimum="0.2" Maximum="1.0" Value="1.0" SmallChange="0.05" LargeChange="0.1"
                                ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="MuteButton" Grid.Column="5" Style="{StaticResource IconButton}"
                            Content="&#xE767;" ToolTip="Mute" Click="Mute_Click" />
                    <Button x:Name="ClickThroughButton" Grid.Column="6" Style="{StaticResource IconButton}"
                            Content="&#xE7C9;" ToolTip="Click-through — mouse passes to the game underneath"
                            Click="ClickThrough_Click" />
                    <Button x:Name="CloseButton" Grid.Column="7" Style="{StaticResource IconButton}"
                            Content="&#xE8BB;" ToolTip="Close overlay" Click="Close_Click" Margin="0,0,4,0" />
                </Grid>
            </Border>

            <!-- Web content -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#101219" />

                <Border x:Name="LoadingOverlay" Background="{StaticResource Background}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Perch" Style="{StaticResource Title}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText" Text="Starting the viewer…" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
