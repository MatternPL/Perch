<Window x:Class="Perch.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Perch Overlay"
        Width="640" Height="380"
        MinWidth="320" MinHeight="200"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        UseLayoutRounding="True">

    <!-- Deliberately frameless: this is a video frame that sits over a game, so a full
         title bar would only eat pixels. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Toolbar" Grid.Row="0" Height="36"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DragHandle" Grid.Column="0" Background="Transparent"
                            Width="28" Cursor="SizeAll" ToolTip="Drag to move">
                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ui:Button x:Name="BackButton" Grid.Column="1" Appearance="Transparent" Padding="6,3"
                               ToolTip="Back" Click="Back_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowLeft24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="ReloadButton" Grid.Column="2" Appearance="Transparent" Padding="6,3"
                               ToolTip="Reload" Click="Reload_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:TextBox x:Name="AddressBox" Grid.Column="3" Margin="6,4" FontSize="12"
                                VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"
                                PlaceholderText="Address — press Enter to go" />


                    <ui:Button x:Name="MuteButton" Grid.Column="4" Appearance="Transparent" Padding="6,3"
                               ToolTip="Mute" Click="Mute_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker224" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="ClickThroughButton" Grid.Column="5" Appearance="Transparent" Padding="6,3"
                               ToolTip="Click-through — the mouse passes to whatever is underneath"
                               Click="ClickThrough_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="ClickThroughIcon" Symbol="Cursor24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="CloseButton" Grid.Column="6" Appearance="Transparent" Padding="6,3"
                               Margin="0,0,4,0" ToolTip="Close overlay" Click="Close_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#101014" />

                <Border x:Name="LoadingOverlay" Background="{DynamicResource ApplicationBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                         HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText" Text="Starting the viewer…" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="260"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
