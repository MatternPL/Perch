<Window x:Class="Perch.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rule"
        Width="560" Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Background}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Height="44" Background="#FF0D0F15">
                <Grid Margin="16,0">
                    <TextBlock x:Name="HeaderText" Text="New rule" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,10">
                <StackPanel>

                    <TextBlock Text="APPLICATION" Style="{StaticResource SectionHeading}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProcessBox" Grid.Column="0" Style="{StaticResource Field}"
                                 ToolTip="Process name without .exe, for example Discord" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Content="Pick running app" Click="PickApp_Click" FontSize="12" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,18"
                               Text="The process name, without .exe — Discord, chrome, Spotify. Not case sensitive." />

                    <TextBlock Text="ONLY WHEN THE TITLE CONTAINS (OPTIONAL)" Style="{StaticResource SectionHeading}" />
                    <TextBox x:Name="TitleBox" Style="{StaticResource Field}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,18"
                               Text="Useful when one app has several windows and you only want to move one of them." />

                    <TextBlock Text="SEND IT TO" Style="{StaticResource SectionHeading}" />
                    <ComboBox x:Name="MonitorCombo" Style="{StaticResource Dropdown}" Margin="0,0,0,18"
                              DisplayMemberPath="Label" />

                    <TextBlock Text="AND MAKE IT" Style="{StaticResource SectionHeading}" />
                    <ComboBox x:Name="StateCombo" Style="{StaticResource Dropdown}" Margin="0,0,0,18">
                        <ComboBoxItem Content="Maximised" Tag="Maximized" />
                        <ComboBoxItem Content="Windowed, centred on that monitor" Tag="Normal" />
                        <ComboBoxItem Content="Minimised" Tag="Minimized" />
                    </ComboBox>

                    <TextBlock Text="EXTRAS" Style="{StaticResource SectionHeading}" />
                    <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource Switch}" Margin="0,0,0,12"
                              Content="Also keep it above other windows" />
                    <CheckBox x:Name="ChkApplyOnce" Style="{StaticResource Switch}" Margin="0,0,0,6"
                              Content="Only the first time each window opens" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="46,0,0,0"
                               Text="Leave this on so you can still move the window yourself afterwards." />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Background="#FF15181F">
                        <StackPanel>
                            <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeading}" />
                            <TextBlock x:Name="PreviewText" Style="{StaticResource Body}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" FontSize="12"
                               Foreground="{StaticResource Danger}" Visibility="Collapsed" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FF0D0F15" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save rule" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
